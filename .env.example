# ─────────────────────────────────────────────────────────────
#  LogicKids — Next.js Fullstack
#  Copie para .env.local e preencha os valores
# ─────────────────────────────────────────────────────────────

# ── Neon PostgreSQL (gratuito) ────────────────────────────────
# 1. Crie conta em https://neon.tech
# 2. Novo projeto → "logickids"
# 3. Connection Details → driver: Prisma
# 4. Copie as duas URLs abaixo

DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/logickids?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/logickids?sslmode=require"

# ── JWT (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
JWT_SECRET="cole-aqui-uma-string-longa-e-aleatoria"

# ── Google Gemini (gratuito) ──────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# ── Next.js ───────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
